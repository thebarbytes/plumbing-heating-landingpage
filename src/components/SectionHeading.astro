---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2' | 'h3';
  id?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'left',
  as = 'h2',
  id,
  class: className,
} = Astro.props;

const Tag = as;
const centered = align === 'center';
---

<div class:list={['max-w-3xl', centered && 'mx-auto text-center', className]} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag id={id} class="mt-3">{title}</Tag>
  {description && <p class:list={['lead mt-4', centered && 'mx-auto']}>{description}</p>}
</div>

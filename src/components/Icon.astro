---
import { iconPaths } from '../lib/icons';
import type { IconKey } from '../lib/icons';

interface Props {
  name: IconKey;
  size?: number;
  strokeWidth?: number;
  label?: string;
  class?: string;
}

const { name, size = 24, strokeWidth = 1.75, label, class: className } = Astro.props;
const definition = iconPaths[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={definition.filled ? 'currentColor' : 'none'}
  stroke={definition.filled ? 'none' : 'currentColor'}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  fill-rule={definition.filled ? 'evenodd' : undefined}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  class:list={['shrink-0', className]}
>
  {definition.paths.map((d) => <path d={d} />)}
</svg>

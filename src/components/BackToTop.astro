---
import Icon from './Icon.astro';
import { siteConfig } from '../config/site';

const { ui } = siteConfig;
---

<button
  type="button"
  id="back-to-top"
  data-visible="false"
  aria-label={ui.backToTopLabel}
  class="invisible fixed right-4 z-[65] bottom-[calc(var(--mobile-bar-h)_+_env(safe-area-inset-bottom,0px)_+_1rem)] inline-flex h-12 w-12 translate-y-3 items-center justify-center rounded-full bg-accent text-ink opacity-0 shadow-lift transition-[opacity,translate,visibility] duration-300 hover:bg-accent-strong data-[visible=true]:visible data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100 md:bottom-6 md:right-6"
>
  <Icon name="arrow-up" size={22} strokeWidth={2.25} />
</button>

<script>
  const button = document.getElementById('back-to-top');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let ticking = false;

  const update = (): void => {
    button?.setAttribute('data-visible', String(window.scrollY > 600));
    ticking = false;
  };

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );

  button?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
  });

  update();
</script>

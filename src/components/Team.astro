---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import Img from './Img.astro';
import { siteConfig } from '../config/site';

const { team } = siteConfig;
---

<Section tone="surface" labelledBy="team-heading">
  <SectionHeading
    id="team-heading"
    eyebrow={team.section.eyebrow}
    title={team.section.title}
    description={team.section.description}
  />

  <ul class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger="100">
    {
      team.members.map((member) => (
        <li data-reveal>
          <figure class="group">
            <div class="relative overflow-hidden rounded-xl ring-1 ring-line">
              <Img
                image={member.image}
                ratio="4 / 5"
                sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                imgClass="transition-transform duration-500 group-hover:scale-105"
              />
              <span
                aria-hidden="true"
                class="absolute inset-x-0 bottom-0 h-1.5 origin-left scale-x-0 bg-accent transition-transform duration-300 group-hover:scale-x-100"
              >
              </span>
            </div>
            <figcaption class="mt-4">
              <p class="font-display text-2xl font-extrabold uppercase leading-none tracking-wide">
                {member.name}
              </p>
              <p class="mt-1 font-display font-bold uppercase tracking-wider text-accent-strong">
                {member.role}
              </p>
              <p class="mt-2 text-sm text-muted">{member.bio}</p>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</Section>

---
import Section from './Section.astro';
import GlowBackground from './GlowBackground.astro';
import Img from './Img.astro';
import Button from './Button.astro';
import { siteConfig } from '../config/site';

const { cta, images, business } = siteConfig;
const banner = cta.banner;
---

<Section tone="light" labelledBy="cta-heading">
  <div
    class="dark relative isolate overflow-hidden rounded-3xl px-6 py-14 shadow-lift sm:px-12 md:py-20"
    data-reveal
  >
    <div aria-hidden="true" class="absolute inset-0 -z-20">
      <Img image={images.cta} fill sizes="(min-width: 1200px) 1200px, 100vw" />
    </div>
    <div
      aria-hidden="true"
      class="absolute inset-0 -z-[15] bg-linear-to-r from-dark/95 via-dark/85 to-dark/40"
    >
    </div>
    <GlowBackground variant="steel" strength="soft" />

    <div class="max-w-2xl">
      <p class="eyebrow">{banner.eyebrow}</p>
      <h2 id="cta-heading" class="mt-3">{banner.title}</h2>
      <p class="lead mt-5">{banner.text}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href={banner.primary.href} size="lg" icon="arrow-right">
          {banner.primary.label}
        </Button>
        <Button
          href={business.phoneHref}
          size="lg"
          variant="outline-light"
          icon="phone"
          iconPosition="left"
        >
          {banner.secondary.label}
        </Button>
      </div>
    </div>
  </div>
</Section>

---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { siteConfig } from '../config/site';
import type { FAQItem } from '../types/site';

interface Props {
  items?: FAQItem[];
  tone?: 'light' | 'surface';
}

const { items, tone = 'light' } = Astro.props;
const { faq, business, cta } = siteConfig;
const list = items ?? faq.items;
---

<Section id="faq" tone={tone} labelledBy="faq-heading">
  <div class="grid items-start gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div>
      <SectionHeading
        id="faq-heading"
        eyebrow={faq.section.eyebrow}
        title={faq.section.title}
        description={faq.section.description}
      />
      <div class="mt-8" data-reveal>
        <Button href={business.phoneHref} variant="dark" icon="phone" iconPosition="left" size="lg">
          {cta.callLabel}: {business.phone}
        </Button>
      </div>
    </div>

    <div class="space-y-3" data-reveal-stagger="70">
      {
        list.map((item) => (
          <div data-reveal>
            <details class="group rounded-xl bg-card ring-1 ring-line transition-shadow open:shadow-card">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-display text-xl font-bold uppercase tracking-wide marker:content-none [&::-webkit-details-marker]:hidden">
                <span>{item.question}</span>
                <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-page transition-all duration-300 group-open:rotate-180 group-open:bg-accent">
                  <Icon name="chevron-down" size={18} strokeWidth={2.25} />
                </span>
              </summary>
              <div class="px-5 pb-5 text-muted">
                <p>{item.answer}</p>
              </div>
            </details>
          </div>
        ))
      }
    </div>
  </div>
</Section>

---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { siteConfig } from '../config/site';

interface Props {
  tone?: 'light' | 'surface';
}

const { tone = 'light' } = Astro.props;
const { emergency } = siteConfig;
---

<Section tone={tone} labelledBy="tips-heading">
  <div class="grid items-start gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div>
      <SectionHeading
        id="tips-heading"
        eyebrow={emergency.tipsSection.eyebrow}
        title={emergency.tipsSection.title}
        description={emergency.tipsSection.description}
      />
      <div class="mt-8" data-reveal>
        <Button href={emergency.phoneHref} size="lg" icon="phone" iconPosition="left">
          {emergency.callLabel}: {emergency.phone}
        </Button>
      </div>
    </div>

    <div>
      <ul class="space-y-3" data-reveal-stagger="90">
        {
          emergency.tips.map((tip, index) => {
            const danger = tip.icon === 'alert';
            const open = index === 0;
            return (
              <li data-reveal>
                <div
                  data-tip
                  data-open={String(open)}
                  class:list={[
                    'group/tip overflow-hidden rounded-xl bg-card',
                    danger ? 'ring-2 ring-red-500/60' : 'ring-1 ring-line',
                  ]}
                >
                  <h3 class="text-base">
                    <button
                      type="button"
                      id={`tip-trigger-${tip.id}`}
                      data-tip-toggle
                      aria-expanded={String(open)}
                      aria-controls={`tip-panel-${tip.id}`}
                      class="flex w-full items-center gap-4 px-5 py-4 text-left"
                    >
                      <span
                        class:list={[
                          'grid h-11 w-11 shrink-0 place-items-center rounded-lg',
                          danger ? 'bg-red-100 text-red-700' : 'bg-accent/15 text-accent-strong',
                        ]}
                      >
                        <Icon name={tip.icon} size={24} />
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="block font-display text-2xl font-extrabold uppercase leading-none tracking-wide">
                          {tip.title}
                        </span>
                        <span class="mt-1 block text-sm text-muted">{tip.summary}</span>
                      </span>
                      <Icon
                        name="chevron-down"
                        size={22}
                        class="transition-transform duration-300 group-data-[open=true]/tip:rotate-180"
                      />
                    </button>
                  </h3>
                  <div
                    id={`tip-panel-${tip.id}`}
                    role="region"
                    aria-labelledby={`tip-trigger-${tip.id}`}
                    class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 group-data-[open=true]/tip:grid-rows-[1fr]"
                  >
                    <div class="invisible overflow-hidden transition-[visibility] duration-300 group-data-[open=true]/tip:visible">
                      <ol class="space-y-3 px-5 pb-5 pt-1">
                        {tip.steps.map((step, stepIndex) => (
                          <li class="flex gap-3">
                            <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-accent font-display text-base font-bold text-ink">
                              {stepIndex + 1}
                            </span>
                            <span class="pt-0.5">{step}</span>
                          </li>
                        ))}
                      </ol>
                    </div>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>

      <p
        class="mt-6 flex items-start gap-3 rounded-lg border-l-4 border-red-600 bg-red-50 p-4 font-medium text-red-900"
        data-reveal
      >
        <Icon name="alert" size={22} class="mt-0.5" />
        {emergency.safetyNote}
      </p>
    </div>
  </div>
</Section>

<script>
  document.querySelectorAll<HTMLElement>('[data-tip]').forEach((tip) => {
    const toggle = tip.querySelector<HTMLButtonElement>('[data-tip-toggle]');
    toggle?.addEventListener('click', () => {
      const open = tip.dataset.open !== 'true';
      tip.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
    });
  });
</script>
